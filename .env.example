# Copy to .env for local runs. docker compose supplies these itself.
APP_ENV=development
PORT=8080
LOG_LEVEL=info

# Postgres. Locally this points at the compose service; on Render it is the
# Neon pooled connection string (…-pooler…, sslmode=require).
DATABASE_URL=postgres://bank:bank@localhost:5432/bank?sslmode=disable

# Guards POST /admin/fund. Generate a random value per environment.
GENESIS_TOKEN=change-me

# Optional: how long in-flight requests get to finish on SIGTERM.
SHUTDOWN_TIMEOUT=15s
